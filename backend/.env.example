DATABASE_URL=postgresql://postgres:password@localhost:5432/find_db
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# AES_KEY must be exactly 64 hex chars (32 bytes for AES-256)
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Comma-separated frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
